# ==========================================
# AARNEX BACKEND CONFIGURATION
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Structured Logger Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Option A: Neon Hosted PostgreSQL (Recommended for local dev without Docker/Postgres)
# Get your connection string from https://console.neon.tech
# Example format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_SSL=true

# Option B: Local PostgreSQL (or Docker Compose local network)
# When running with Docker Compose, API connects via: postgresql://postgres:postgres@postgres:5432/aarnex_db
DATABASE_URL=postgresql://neondb_owner:npg_fDqMJu7XR5jU@ep-sparkling-scene-b4ijtak9-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_SSL=false

# ==========================================
# AUTHENTICATION & SECURITY (JWT)
# ==========================================
# Replace these with cryptographically strong secrets in production
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# Token lifetimes (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Rate Limiting for Auth Endpoints (max attempts per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# DETERMINISTIC SEED CREDENTIALS
# ==========================================
# Seed script will use these default passwords for seeded accounts if not overridden
SEED_ADMIN_EMAIL=admin@aarnex.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_DEFAULT_USER_PASSWORD=User@123456
